{
  "name": "playwright-login-demo",
  "version": "1.0.0",
  "description": "Interview demo for Playwright login automation using locators, page objects, tests, and CSV test data.",
  "private": true,
  "scripts": {
    "test": "PLAYWRIGHT_BROWSERS_PATH=./.cache/ms-playwright playwright test",
    "test:headed": "PLAYWRIGHT_BROWSERS_PATH=./.cache/ms-playwright playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
