# Copy this to .env.qa / .env.uat / .env.prod and fill in real values.
# Never commit .env.* files that contain real credentials.

BASE_URL=https://your-app-url.com
AUTH_USERNAME=your_username
AUTH_PASSWORD=your_password

# API testing — DummyJSON demo API (https://dummyjson.com). No API key or
# signup needed for the /auth/login and /users endpoints used here.
API_BASE_URL=https://dummyjson.com
